{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug baka (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/baka",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "engineLogging": false,
                "programOutput": true
            }
        },
        {
            "name": "Debug baka (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/baka",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Run without debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/baka",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build-release",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Attach to Process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/baka",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug with Core Dump",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/baka",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "text": "core-file core"
                },
                {
                    "text": "bt full",
                    "description": "Show backtrace with local variables"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}